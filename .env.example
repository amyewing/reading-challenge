# Copy this file to .env.local and fill in your values.

# --- Front end (public: these end up in the browser) ---
# Kinde: Settings > Applications > (your Front-end/SPA app) > Details
VITE_KINDE_CLIENT_ID=your_kinde_client_id
VITE_KINDE_DOMAIN=https://yourbusiness.kinde.com
# Kinde: Settings > APIs > (your API) > Audience
VITE_KINDE_AUDIENCE=https://api.readingchallenge

# --- API server (secret: never commit, never prefix with VITE_) ---
# Neon dashboard > Connect > turn ON "Connection pooling" > copy the postgresql://... string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# The API reads KINDE_DOMAIN / KINDE_AUDIENCE, falling back to the VITE_ values above locally.

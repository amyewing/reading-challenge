{
  "name": "reading-challenge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --env-file=.env.local api/dev-server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api",
    "build": "npm run typecheck && vite build",
    "build:api": "esbuild api/function.ts --bundle --platform=node --target=node22 --format=cjs --external:pg-native --outfile=functions/packages/core/api.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kinde-oss/kinde-auth-react": "^5.0.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
